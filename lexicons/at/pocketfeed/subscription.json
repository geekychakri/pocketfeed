{
  "lexicon": 1,
  "id": "at.pocketfeed.subscription",
  "defs": {
    "main": {
      "type": "record",
      "description": "Pocket feed subscription",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["feedUrl", "createdAt"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 512,
            "description": "Feed title"
          },
          "feedUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "RSS Feed URL"
          },
          "favicon": {
            "type": "string",
            "maxLength": 2048,
            "description": "Website favicon"
          },
          "siteUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "Website URL"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
